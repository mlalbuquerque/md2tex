# ==============================================================================
# .gitattributes - md2tex
# Normalização de quebra de linha (LF) e marcação de tipos de arquivo.
# ==============================================================================

# Definição padrão para texto
* text=auto eol=lf

# Scripts e Código Fonte
*.py text eol=lf
*.sh text eol=lf
*.lua text eol=lf
*.md text eol=lf
*.j2 text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binários e Mídias
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
*.tar.gz binary
*.zip binary
